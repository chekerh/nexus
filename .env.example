# Nexus-UGC v2 — Environment Configuration
# ==========================================

# --- Whisper ---
WHISPER_BINARY_PATH=/usr/local/bin/whisper-main
WHISPER_MODEL_PATH=/usr/local/share/whisper/models/ggml-base.en.bin
WHISPER_THREADS=4
WHISPER_PROCESSORS=1
WHISPER_LANGUAGE=en
WHISPER_TRANSLATE=false

# --- Ollama ---
OLLAMA_MODEL=phi3
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_ANALYST_MODEL=
OLLAMA_STYLE_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=3m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=700
OLLAMA_STYLE_NUM_CTX=1024
OLLAMA_STYLE_NUM_PREDICT=120

# --- AI Backend ---
ANALYSIS_BACKEND=ollama           # ollama | airllm
ANALYSIS_AUTO_UNLOAD_AFTER_PROCESS=false
AIRLLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_WARM_ON_START=true

# --- Analysis ---
ANALYSIS_TRANSCRIPT_MAX_CHARS=9000
ANALYSIS_MAX_CANDIDATES=8
ANALYSIS_ENABLE_SCENE_DETECTION=false

# --- Processing ---
PROCESSING_PROFILE=balanced       # eco | balanced | quality
VIDEO_ENCODER=auto                # auto | h264_videotoolbox | libx264
VIDEO_THREADS=2
CLIP_FORMAT_PRESET=vertical_9_16  # source | vertical_9_16 | square_1_1 | portrait_4_5
CLIP_MIN_SECONDS=12
CLIP_MAX_SECONDS=45
CLIP_PADDING_SECONDS=1.5
CLIP_DURATION_DIVERSITY=0.45

# --- Video Effects ---
CLIP_ENABLE_TRANSITIONS=true
CLIP_FADE_SECONDS=0.35
CLIP_ENABLE_SUBTLE_ZOOM=true
CLIP_ZOOM_MAX=1.05
CLIP_ENABLE_SUBTITLES=true
CLIP_SUBTITLE_PRESET=bold_center
CLIP_SUBTITLE_MAX_WORDS=10
CLIP_ENABLE_ANIMATED_CAPTIONS=true
CLIP_CAPTION_FONT_SIZE=48
CLIP_CAPTION_HIGHLIGHT_WORDS=

# --- Caption Styles ---
CAPTION_STYLE_MODE=hybrid         # rule | ai | hybrid
CAPTION_STYLE_AI_MAX_CUES=60
CAPTION_STYLE_MIN_VARIETY=4

# --- Strategist Prompts ---
STRATEGIST_PROMPT_FILE=./prompts/strategist_system.md
VIRAL_SIGNALS_FILE=./prompts/viral_signals.md

# --- CTA ---
CAPTION_CTA_ENABLED=true
CAPTION_CTA_DEFAULT_TEXT=Link in bio to try it free.
CAPTION_CTA_END_IMAGE_DURATION=3.0

# --- Social Publishing ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_GRAPH_VERSION=v22.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE=https://open.tiktokapis.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PUBLIC_BASE_URL=

# --- Database (v2) ---
# Leave empty for SQLite (local dev).
# For production: postgresql://user:pass@host:5432/nexus
DATABASE_URL=

# --- Google OAuth ---
# Create a Google Cloud Console project → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Add http://localhost:8000/login.html and your production URL to Authorized JavaScript origins
# Add http://localhost:8000 and your production URL to Authorized redirect URIs
GOOGLE_CLIENT_ID=
INVITE_REQUIRED_FOR_GOOGLE=true

# --- Security ---
JWT_SECRET=nexus-dev-secret-change-in-production
JWT_EXPIRY_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_BACKEND=memory    # memory | database (use 'database' for multi-worker production)
MAX_UPLOAD_SIZE_MB=500
CSRF_ENABLED=true
SECURITY_HEADERS_ENABLED=true
# CORS_ORIGINS — comma-separated list. Wildcard (*) disables credentials.
# For production, always list explicit origins:
# CORS_ORIGINS=https://app.nexusugc.com,https://admin.nexusugc.com
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000

# --- Error Tracking ---
SENTRY_DSN=

# --- Stripe (v2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Whop ---
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRO_PRODUCT_ID=
WHOP_ENTERPRISE_PRODUCT_ID=

# --- Auto-Accounts (System-Level Platform Credentials) ---
# When SYSTEM_ACCOUNTS_ENABLED=true, the app auto-creates platform accounts
# from these credentials on startup. No manual OAuth setup needed.
SYSTEM_ACCOUNTS_ENABLED=false
SYSTEM_YOUTUBE_REFRESH_TOKEN=
SYSTEM_YOUTUBE_CHANNEL_ID=
SYSTEM_TIKTOK_ACCESS_TOKEN=
SYSTEM_TIKTOK_REFRESH_TOKEN=
SYSTEM_TIKTOK_OPEN_ID=
SYSTEM_INSTAGRAM_ACCESS_TOKEN=
SYSTEM_INSTAGRAM_USER_ID=
SYSTEM_TWITTER_ACCESS_TOKEN=
SYSTEM_TWITTER_USER_ID=
SYSTEM_FACEBOOK_ACCESS_TOKEN=
SYSTEM_FACEBOOK_PAGE_ID=
SYSTEM_LINKEDIN_ACCESS_TOKEN=
SYSTEM_LINKEDIN_USER_ID=

# --- Azure Deployment ---
# Required when hosting on Azure App Service.
# DATABASE_URL must be set to Azure Database for PostgreSQL or an external PostgreSQL.
# Generate a strong JWT_SECRET: python3 -c "import secrets; print(secrets.token_hex(32))"
# Set POSTGRES_PASSWORD to a strong password for the local PostgreSQL container.
# Example:
#   DATABASE_URL=postgresql://nexus:password@db:5432/nexus
#   PUBLIC_BASE_URL=https://your-app.azurewebsites.net
#   JWT_SECRET=your-256-bit-hex-secret
#   POSTGRES_PASSWORD=your-strong-db-password
