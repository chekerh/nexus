# Nexus-UGC v2 — Environment Configuration
# ==========================================

# --- Whisper ---
WHISPER_BINARY_PATH=/usr/local/bin/whisper-main
WHISPER_MODEL_PATH=/usr/local/share/whisper/models/ggml-base.en.bin
WHISPER_THREADS=4
WHISPER_PROCESSORS=1
WHISPER_LANGUAGE=en
WHISPER_TRANSLATE=false

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_ANALYST_MODEL=
OLLAMA_STYLE_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=3m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=700
OLLAMA_STYLE_NUM_CTX=1024
OLLAMA_STYLE_NUM_PREDICT=120

# --- AI Backend ---
ANALYSIS_BACKEND=ollama           # ollama | airllm
ANALYSIS_AUTO_UNLOAD_AFTER_PROCESS=false
AIRLLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_WARM_ON_START=true

# --- Analysis ---
ANALYSIS_TRANSCRIPT_MAX_CHARS=9000
ANALYSIS_MAX_CANDIDATES=8
ANALYSIS_ENABLE_SCENE_DETECTION=false

# --- Processing ---
PROCESSING_PROFILE=balanced       # eco | balanced | quality
VIDEO_ENCODER=auto                # auto | h264_videotoolbox | libx264
VIDEO_THREADS=2
CLIP_FORMAT_PRESET=vertical_9_16  # source | vertical_9_16 | square_1_1 | portrait_4_5
CLIP_MIN_SECONDS=12
CLIP_MAX_SECONDS=45
CLIP_PADDING_SECONDS=1.5
CLIP_DURATION_DIVERSITY=0.45

# --- Video Effects ---
CLIP_ENABLE_TRANSITIONS=true
CLIP_FADE_SECONDS=0.35
CLIP_ENABLE_SUBTLE_ZOOM=true
CLIP_ZOOM_MAX=1.05
CLIP_ENABLE_SUBTITLES=true
CLIP_SUBTITLE_PRESET=bold_center
CLIP_SUBTITLE_MAX_WORDS=10
CLIP_ENABLE_ANIMATED_CAPTIONS=true
CLIP_CAPTION_FONT_SIZE=48
CLIP_CAPTION_HIGHLIGHT_WORDS=

# --- Caption Styles ---
CAPTION_STYLE_MODE=hybrid         # rule | ai | hybrid
CAPTION_STYLE_AI_MAX_CUES=60
CAPTION_STYLE_MIN_VARIETY=4

# --- Strategist Prompts ---
STRATEGIST_PROMPT_FILE=./prompts/strategist_system.md
VIRAL_SIGNALS_FILE=./prompts/viral_signals.md

# --- CTA ---
CAPTION_CTA_ENABLED=true
CAPTION_CTA_DEFAULT_TEXT=Link in bio to try it free.
CAPTION_CTA_END_IMAGE_DURATION=3.0

# --- Social Publishing ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_GRAPH_VERSION=v22.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE=https://open.tiktokapis.com
PUBLIC_BASE_URL=

# --- Database (v2) ---
# Leave empty for SQLite (local dev).
# For production: postgresql://user:pass@host:5432/nexus
DATABASE_URL=

# --- Auth ---
JWT_SECRET=nexus-dev-secret-change-in-production

# --- Stripe (v2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
